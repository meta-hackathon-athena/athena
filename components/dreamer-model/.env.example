# Copy to .env and fill in. Never commit .env — it is gitignored.
# config.py loads this file, then the repository .env.

# --- FalkorDB ---------------------------------------------------------------
# A server URL. Omit it entirely to use the embedded falkordblite file
# (data/prod_dreamer.rdb), which needs no server.
FALKORDB_URL=falkor://user:password@host:6379

# The graph to dream into. One graph per user.
# DREAMER_GRAPH_NAME=vixy_dreamer
# unified = the shared Vixy graph vixy_<user> written by the master-repo runtime
# DREAMER_GRAPH_LAYOUT=legacy

# --- Meta Muse (Responses API) ---------------------------------------------
# Required for `dream`. Without it the deterministic rules fallback is used.
MODEL_API_KEY=your-meta-key

# MUSE_MODEL=muse-spark-1.3
# "-contributor" models let Meta train on the content: refused unless set, synthetic data only
# DREAMER_ALLOW_CONTRIBUTOR_MODEL=0
# MUSE_URL=https://api.meta.ai/v1/responses

# --- Identity and local time ----------------------------------------------
# DREAMER_SESSION_ID=wearer-01
# DREAMER_TZ=Asia/Singapore
# DREAMER_EVENTS_DB=data/prod_dreamer_events.sqlite3
# DREAMER_DB_PATH=data/prod_dreamer.rdb

# --- context-engine (only needed for `seed`) ------------------------------
# Either install the package, or point at a checkout here.
# CONTEXT_ENGINE_SRC=../context-engine/src
