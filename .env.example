# Copy to .env (repository root) and fill in locally. .env is gitignored; never commit real keys.
# Everything runs offline without any key. ./scripts/bootstrap.sh creates .env from this file.
#
# SECURITY NOTE: a Baseten API key was committed to the history of the original
# meta-hackathon-athena/master-repo (commit aa020ad). The account owner confirmed revocation
# on 2026-11-04. This monorepo was created from clean snapshots and contains none of that history.

# --- Identity (one canonical user for the demo) ----------------------------
VIXY_USER_ID=demo
# Sessions that belong to VIXY_USER_ID (comma separated). Default: the user id.
# VIXY_SESSION_IDS=demo
VIXY_TZ=Asia/Singapore

# --- Shared FalkorDB (docker compose up -d falkordb) -----------------------
# Unset = embedded falkordblite file (single process only, tests/dev).
FALKORDB_URL=redis://localhost:6390
# VIXY_DB_PATH=data/vixy.rdb            # embedded mode only
# VIXY_GRAPH_PREFIX=vixy                # set to "veyra" to open legacy graphs

# --- Context Engine + runtime state (SQLite) -------------------------------
# VIXY_EVENTS_DB=data/vixy_events.sqlite3
# VIXY_RUNTIME_DB=data/vixy_runtime.sqlite3

# --- Optional LLM for the Active Agent (off unless a model is set) ---------
# VIXY_LLM_MODEL=
# Uses shared MODEL_API_KEY and the Meta chat endpoint; no legacy key fallback.

# --- Dreamer (Meta Model API) — NOT used in Milestone 1 (offline only) -----
# MODEL_API_KEY=
# MUSE_MODEL=muse-spark-1.3
# Contributor models let Meta train on submitted content. They are refused
# unless this is set, and must only ever see synthetic data:
# DREAMER_ALLOW_CONTRIBUTOR_MODEL=0

# --- Legacy (yolomodelvision scripts only; paid API — do not run in tests) --
# BASETEN_API_KEY=

# --- Shared Meta configuration (inference remains explicitly opt-in) --------
# Process environment wins, including an explicit empty value for offline tests.
# VIXY_ENV_FILE can select a different local env file. The repository-root .env
# is loaded by the runtime, model settings, and standalone Dreamer.
# MODEL_API_KEY=
# MUSE_MODEL=muse-spark-1.3
# VIXY_MODEL_ID=muse-spark-1.3
# VIXY_MODEL_MAX_CALLS=20
# VIXY_MODEL_TIMEOUT_S=30
# VIXY_MODEL_MAX_OUTPUT_TOKENS=1200
# VIXY_MODEL_REASONING=low
# DREAMER_EXTRACT_MAX_CALLS=20
# MUSE_STORE_RESPONSES=0
# Integrated wearable runtime forbids contributor models even if a legacy
# synthetic-only override is present. process/replay never invoke remote inference.
